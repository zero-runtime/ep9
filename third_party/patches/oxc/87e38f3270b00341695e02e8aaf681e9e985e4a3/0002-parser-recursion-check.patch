 /// * If your application uses multiple sets of options, probably a runtime config is preferable.
 ///
-/// At present the only option controlled by `ParserConfig` is whether to parse with or without tokens.
+/// At present `ParserConfig` controls whether to parse with or without tokens, and whether the
+/// parser asks the config before each recursion ([`ParserConfig::may_recurse`]).
 /// Other options will be added in future.
 ///
 /// You can also create your own config by implementing [`ParserConfig`] on a type.
@@ -44,6 +45,32 @@ pub trait ParserConfig: Default + 'static {
 
     /// Get [`LexerConfig`] for this [`ParserConfig`].
     fn lexer_config(&self) -> Self::LexerConfig;
+
+    /// `true` if the parser calls [`may_recurse`] at each recursion entry.
+    ///
+    /// Default: `false`. Then no check is compiled in, and the parse has no cost from it.
+    ///
+    /// [`may_recurse`]: ParserConfig::may_recurse
+    const CHECKS_RECURSION: bool = false;
+
+    /// Asked at each recursion entry of the parser (a function that the parser can enter again
+    /// before it returns, through nested source), when [`CHECKS_RECURSION`] is `true`.
+    ///
+    /// Return `false` to stop the parse, for example when the native stack is near its end:
+    /// compare the stack pointer with a limit. Then the parse ends with one fatal
+    /// "Maximum call stack size exceeded" error and [`ParserReturn::stack_limit_hit`] is `true`.
+    /// The parser does not ask again after the parse ends, but it can ask again before that (after
+    /// a rewind of a speculative parse), so a config that returned `false` should keep returning
+    /// `false` to stop at once.
+    ///
+    /// Default: `true` (never stop).
+    ///
+    /// [`CHECKS_RECURSION`]: ParserConfig::CHECKS_RECURSION
+    /// [`ParserReturn::stack_limit_hit`]: crate::ParserReturn::stack_limit_hit
+    #[inline(always)]
+    fn may_recurse(&self) -> bool {
+        true
+    }
 }
 
 /// Parser config for parsing without tokens (default).
