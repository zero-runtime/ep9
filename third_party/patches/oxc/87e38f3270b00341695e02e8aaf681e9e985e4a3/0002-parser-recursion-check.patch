index 94b2960a..3467187b 100644
--- a/crates/oxc_parser/src/config.rs
+++ b/crates/oxc_parser/src/config.rs
@@ -27,7 +27,8 @@ use crate::lexer::{ByteHandler, ByteHandlers, byte_handler_tables};
