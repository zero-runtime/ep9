diff --git a/crates/oxc_parser/src/error_handler.rs b/crates/oxc_parser/src/error_handler.rs
index 2cb15e67..e8da804b 100644
--- a/crates/oxc_parser/src/error_handler.rs
+++ b/crates/oxc_parser/src/error_handler.rs
@@ -94,6 +94,48 @@ impl<'a, C: Config> ParserImpl<'a, C> {
         Dummy::dummy(self.allocator())
     }
 
+    /// Stop the parse at a recursion entry, because [`ParserConfig::may_recurse`] returned
+    /// `false`. Sets the stop flag and a fatal error, as [`Self::fatal_error`] does.
+    ///
+    /// A rewind restores the fatal error of its checkpoint, so it can drop this one; the flag stays
+    /// set, and the parse exit reads it (see [`Self::take_stack_limit_error`]).
+    ///
+    /// [`ParserConfig::may_recurse`]: crate::ParserConfig::may_recurse
+    #[cold]
+    #[inline(never)]
+    pub(crate) fn recursion_stopped<T: Dummy<'a>>(&mut self) -> T {
+        self.stack_limit_hit.set(true);
+        let error = diagnostics::stack_limit(self.cur_token().span());
+        self.fatal_error(error)
+    }
+
+    /// Stop the parse at a recursion entry of a check that takes `&self` (a walk over a built
+    /// subtree that returns its error to the caller), because [`ParserConfig::may_recurse`]
+    /// returned `false`. Sets the stop flag and returns the error: the check cannot set a fatal
+    /// error, so its caller reports the error or goes on, and the parse exit reads the flag (see
+    /// [`Self::take_stack_limit_error`]).
+    ///
+    /// [`ParserConfig::may_recurse`]: crate::ParserConfig::may_recurse
+    #[cold]
+    #[inline(never)]
+    pub(crate) fn recursion_stopped_error(&self) -> ParserDiagnostic<'a> {
+        self.stack_limit_hit.set(true);
+        diagnostics::stack_limit(self.cur_token().span())
+    }
+
+    /// At a parse exit: the one diagnostic of a recursion stop, if the flag is set. Takes the
+    /// fatal error (the stop wins over it) and uses its span when it is the stop's own error.
+    pub(crate) fn take_stack_limit_error(&mut self) -> Option<ParserDiagnostic<'a>> {
+        if !self.stack_limit_hit.get() {
+            return None;
+        }
+        let span = match self.fatal_error.take() {
+            Some(FatalError { error: ParserDiagnostic::stack_limit { span }, .. }) => span,
+            _ => self.cur_token().span(),
+        };
+        Some(diagnostics::stack_limit(span))
+    }
+
     pub(crate) fn has_fatal_error(&self) -> bool {
         matches!(self.cur_kind(), Kind::Eof | Kind::Undetermined) || self.fatal_error.is_some()
     }
